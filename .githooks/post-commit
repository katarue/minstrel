#!/bin/sh
# Auto-push hook: すべてのブランチで即 push（ソロ開発 / main 直接コミット運用）

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ -z "$branch" ]; then
    exit 0
fi

echo "[post-commit] Auto-pushing $branch to origin..."
if git push origin "$branch" 2>&1; then
    echo "[post-commit] Pushed successfully"
else
    echo "[post-commit] Auto-push failed. Run 'git push origin $branch' manually."
fi

# [decision] タグ検出 → GitHub Issue 自動起票
if [ -f "$HOME/.claude/hooks/decision-issue.sh" ]; then
    sh "$HOME/.claude/hooks/decision-issue.sh"
fi

exit 0
